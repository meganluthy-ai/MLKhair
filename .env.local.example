# Copy to .env.local and fill in. Never commit real values.

# Resend (quiz results + contact + newsletter)
RESEND_API_KEY=
# Where intake/contact submissions are delivered (Megan's inbox)
MLK_NOTIFY_EMAIL=megan@mlkhair.com
# Verified "from" sender on the mlkhair.com domain in Resend
MLK_FROM_EMAIL=megan@mlkhair.com

# Sanity (blog) — P1, fill when the dataset is created
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Google site verification (carry over the existing tag from Wix — OPEN: need full value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 (OPEN: create new property keyed to scalp-analysis bookings)
NEXT_PUBLIC_GA_ID=
